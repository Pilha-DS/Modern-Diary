APP_NAME=Modern Diary API
ENVIRONMENT=development

# Banco local (fora do Docker). No docker compose o host é sobrescrito para "db".
MYSQL_DATABASE=modern_diary
MYSQL_USER=modern_diary
MYSQL_PASSWORD=modern_diary_dev
MYSQL_ROOT_PASSWORD=modern_diary_root_dev
DATABASE_URL=mysql+pymysql://modern_diary:modern_diary_dev@localhost:3306/modern_diary

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-secret-key-change-me-000000000000000000
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origens do Flutter web, separadas por vírgula. "*" libera todas (só em dev).
CORS_ORIGINS=*

# Portas publicadas no host pelo docker compose. Troque se já estiverem em uso.
API_PORT=8000
MYSQL_PORT=3306
